---
const cafe = [
  {name:'Espresso',desc:'Intenso y corto, con notas de cacao.',price:2200,image:'espresso'},
  {name:'Americano',desc:'Espresso largo con agua caliente.',price:2600,image:'americano'},
  {name:'Cortado',desc:'Espresso con un poco de leche cremosa.',price:2900,image:'cortado'},
  {name:'Latte',desc:'Doble espresso con leche texturizada.',price:3600,image:'latte',badge:'Disponible con leche vegetal'},
  {name:'Matcha latte',desc:'Matcha ceremonial y leche texturizada.',price:3800,image:'matcha'},
  {name:'Cold brew',desc:'Infusionado en frío por 18 horas, con hielo.',price:3900,image:'cold-brew',badge:'Nuevo'}
];
const comida = [
  {name:'Cheesecake de frutos rojos',desc:'Base de galleta, crema suave y frutos rojos.',price:3900,image:'cheesecake'},
  {name:'Cinnamon roll',desc:'Masa suave, canela y glaseado.',price:3200,image:'cinnamon-roll'},
  {name:'Tostada de palta y huevo',desc:'Pan tostado, palta y huevo.',price:6200,image:'palta-huevo',badge:'Vegetariano'}
];
const money = n => '$'+n.toLocaleString('es-CL');
const photo = (id) => '/images/bruma/'+id+'.webp';
---
<html lang="es">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="theme-color" content="#243328"/>
<meta name="description" content="Menú de demostración de Bruma Café. Café de especialidad, pastelería y brunch."/>
<title>Bruma café — Menú digital</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/>
<style>
:root{font-family:'DM Sans',sans-serif;color:#252821;background:#eeeae3;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit}h1,h2,h3,p{margin-top:0}.page{max-width:760px;margin:auto;background:#f7f4ee;min-height:100vh;box-shadow:0 0 55px #00000012}.serif,h1,h2{font-family:'Libre Caslon Display',Georgia,serif;font-weight:400}.hero{position:relative;min-height:360px;color:#fff;background:#3d4135;overflow:hidden}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 43%}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#171c16c9 0%,#1d25184d 66%,#00000013 100%)}.hero-content{position:relative;z-index:1;padding:34px 30px 28px;max-width:450px}.eyebrow{font-size:.69rem;letter-spacing:.18em;line-height:1.6;text-transform:uppercase;font-weight:700}.hero h1{font-size:clamp(5rem,15vw,7rem);line-height:.9;margin:16px 0 0;letter-spacing:-.035em}.hero .cafe{font-family:Georgia,serif;font-size:2rem;font-style:italic}.details{margin-top:32px;display:grid;gap:15px;font-size:.85rem}.details strong{display:block;font-weight:700}.details span{display:block;opacity:.85}.body{padding:0 22px 28px}.tabs{display:flex;gap:7px;overflow:auto;scrollbar-width:none;position:sticky;top:0;background:#f7f4eef2;backdrop-filter:blur(12px);z-index:3;padding:14px 0}.tabs a{flex:none;text-decoration:none;padding:10px 18px;border:1px solid #dcded5;border-radius:30px;font-size:.84rem}.tabs a:first-child{background:#263b2b;color:white;border-color:#263b2b}.feature{display:grid;grid-template-columns:1fr 1fr;background:#293b2c;border-radius:22px;overflow:hidden;min-height:250px;color:#fff;margin:8px 0 27px}.feature-text{padding:24px 10px 24px 23px;align-self:center;position:relative;z-index:1}.feature h2{font-size:clamp(2rem,6vw,3rem);line-height:1.02;margin:12px 0}.feature p{font-size:.83rem;line-height:1.55;color:#e6e7df}.feature .price{font-family:Georgia,serif;font-size:1.7rem}.feature img{height:100%;width:100%;object-fit:cover;object-position:center}.section{scroll-margin-top:75px;margin-top:25px}.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:14px;border-bottom:1px solid #d8d5cd;padding-bottom:8px;margin-bottom:7px}.section h2{font-size:3rem;margin:0;line-height:1}.section-head small{text-align:right;font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:#777b70}.item{display:grid;grid-template-columns:76px minmax(0,1fr) auto;gap:12px;padding:11px 0;border-bottom:1px solid #e0ded6;align-items:center}.item:last-child{border-bottom:0}.item img{width:76px;height:70px;border-radius:11px;object-fit:cover;background:#e3dfd5}.item h3{font-size:.91rem;margin:0 0 4px;font-weight:700}.item p{font-size:.76rem;color:#7d8078;line-height:1.4;margin:0}.item .price{font-size:.84rem;white-space:nowrap;align-self:start;padding-top:4px;font-weight:600}.badge{display:inline-block;margin-top:6px;border-radius:30px;padding:3px 9px;background:#e1e6da;color:#425a42;font-size:.65rem}.notice{background:#e9e9e2;padding:15px 18px;border-radius:14px;font-size:.79rem;margin:18px 0 26px;color:#475449}.footer-card{position:relative;border-radius:22px;overflow:hidden;min-height:195px;background:#243629;color:#fff;margin-top:27px}.footer-card img{position:absolute;right:0;top:0;width:55%;height:100%;object-fit:cover}.footer-card:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#243629 0%,#243629 44%,#243629cf 61%,transparent 100%)}.footer-content{position:relative;z-index:1;max-width:76%;padding:22px}.footer-card h2{font-size:2.35rem;line-height:1.05;margin:0 0 10px}.footer-card p{font-size:.8rem;line-height:1.5;color:#e5e6dd}.footer-card a{display:inline-block;text-decoration:none;border:1px solid #ffffffaa;border-radius:30px;padding:10px 13px;font-size:.75rem}.disclaimer{text-align:center;color:#797a70;font-size:.69rem;margin:25px 0 4px}@media(min-width:650px){.hero{min-height:420px}.hero-content{padding:45px}.body{padding:0 34px 34px}.item{grid-template-columns:95px 1fr auto;gap:18px}.item img{width:95px;height:75px}.feature{min-height:280px}.feature-text{padding:30px}}@media(max-width:370px){.body{padding:0 15px 20px}.feature{grid-template-columns:55% 45%}.feature-text{padding:18px 4px 18px 16px}.feature h2{font-size:1.9rem}.item{grid-template-columns:60px minmax(0,1fr) auto;gap:8px}.item img{width:60px;height:65px}.item h3{font-size:.82rem}.item .price{font-size:.76rem}.section h2{font-size:2.55rem}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body><div class="page">
<header class="hero"><img src={photo('interior')} alt="Interior de cafetería con mesas de madera y lámparas cálidas" fetchpriority="high"/><div class="hero-content"><div class="eyebrow">Café de especialidad<br/>en Valparaíso</div><h1>Bruma</h1><div class="cafe">café</div><div class="details"><div><span>◷ &nbsp; Hoy abrimos</span><strong>8:00 a 19:00</strong></div><div><span>⌁ &nbsp; Wi-Fi</span><strong>bruma2026</strong></div></div></div></header>
<div class="body">
<nav class="tabs" aria-label="Categorías del menú"><a href="#cafe">Café</a><a href="#cafe">Frío</a><a href="#pasteleria">Pastelería</a><a href="#pasteleria">Brunch</a></nav>
<aside class="feature"><div class="feature-text"><div class="eyebrow">Destacado</div><h2>Latte de lavanda y miel</h2><p>Espresso doble, leche texturizada y un toque de miel de ulmo. Suave y floral.</p><div class="price">$4.200</div></div><img src={photo('latte')} alt="Taza de café con leche" loading="lazy"/></aside>
<section class="section" id="cafe"><div class="section-head"><h2>Café</h2><small>Granos tostados en Valparaíso</small></div>{cafe.map(item=><article class="item"><img src={photo(item.image)} alt={item.name} loading="lazy"/><div><h3>{item.name}</h3><p>{item.desc}</p>{item.badge&&<span class="badge">{item.badge}</span>}</div><span class="price">{money(item.price)}</span></article>)}</section>
<div class="notice">♧ &nbsp; Cambia a leche de avena o almendras por +$500</div>
<section class="section" id="pasteleria"><div class="section-head"><h2>Pastelería y brunch</h2><small>Preparaciones de la casa</small></div>{comida.map(item=><article class="item"><img src={photo(item.image)} alt={item.name} loading="lazy"/><div><h3>{item.name}</h3><p>{item.desc}</p>{item.badge&&<span class="badge">{item.badge}</span>}</div><span class="price">{money(item.price)}</span></article>)}</section>
<footer class="footer-card"><img src={photo('terraza')} alt="Terraza con mesa y sillas de madera" loading="lazy"/><div class="footer-content"><h2>Pide en la barra</h2><p>Dinos tu número de mesa y te llevamos todo. Pagas al final, sin apuro.</p><a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Ver Instagram ↗</a></div></footer>
<p class="disclaimer">Menú de demostración · Negocio, precios y contacto ficticios</p>
</div></div></body></html>