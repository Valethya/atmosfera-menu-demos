---
import { menus } from '../../data/menus.js';
export function getStaticPaths(){ return Object.entries(menus).map(([slug,menu])=>({params:{slug},props:{menu}})); }
const {menu} = Astro.props;
const money = n => '$' + n.toLocaleString('es-CL');
---
<html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content={menu.theme==='bruma'?'#eae9df':'#171714'}/><title>{menu.name} | Menú digital</title><style is:global>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif}body.bruma{background:#eae9df;color:#23382f;--accent:#617969;--panel:#f8f7f0}body.fuego{background:#171714;color:#f6eedf;--accent:#ff7043;--panel:#282823}a{color:inherit}.wrap{max-width:1000px;margin:auto;padding:0 22px}header{display:flex;justify-content:space-between;align-items:center;padding-top:26px;padding-bottom:24px;gap:16px}header .logo{font-size:1.3rem;font-weight:900;letter-spacing:-.055em}header .tag{font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;text-align:right;max-width:190px}main{padding-bottom:80px}.hero{padding:65px 0 50px;border-top:1px solid currentColor}.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:.75rem;font-weight:bold}.hero h1{font-size:clamp(4rem,13vw,9rem);line-height:.87;letter-spacing:-.085em;margin:26px 0 24px;max-width:850px}.fuego .hero h1{text-transform:uppercase;font-weight:1000}.bruma .hero h1{font-family:Georgia,serif;font-weight:400}.hero p{font-size:1.12rem;max-width:470px;line-height:1.55}.ornament{height:185px;margin:24px 0 45px;border-radius:90px 8px 90px 8px;background:radial-gradient(circle at 27% 48%,#c9b7a0 0 9%,transparent 10%),radial-gradient(circle at 64% 47%,#fff2da 0 17%,transparent 18%),linear-gradient(120deg,#748a78,#b7b49a)}.fuego .ornament{border-radius:4px;background:radial-gradient(circle at 70% 50%,#ffae42 0 14%,transparent 15%),repeating-linear-gradient(-25deg,transparent 0 25px,#e95b37 26px 35px),#923d26}nav{display:flex;gap:10px;overflow-x:auto;position:sticky;top:0;padding:14px 0;background:inherit;z-index:2}nav a{white-space:nowrap;text-decoration:none;border:1px solid currentColor;border-radius:30px;padding:10px 17px;font-size:.85rem}nav a:hover{background:var(--accent);color:white}section{padding-top:48px;scroll-margin-top:65px}h2{font-size:clamp(2.6rem,7vw,4.5rem);letter-spacing:-.065em;margin:0 0 22px}.bruma h2{font-family:Georgia,serif;font-weight:400}.fuego h2{text-transform:uppercase}.item{display:flex;justify-content:space-between;gap:18px;border-top:1px solid currentColor;padding:20px 0}.item h3{font-size:1.15rem;margin:0 0 7px}.item p{margin:0;opacity:.72;font-size:.91rem;line-height:1.5}.price{white-space:nowrap;font-weight:800;font-size:1.05rem}.fuego .price{color:var(--accent)}footer{border-top:1px solid currentColor;padding:30px 0 45px;font-size:.85rem;line-height:1.8}footer a{font-weight:bold}.notice{opacity:.65;font-size:.75rem}@media(min-width:750px){.ornament{height:270px}.item{padding:25px 0}}
</style></head><body class={menu.theme}><div class="wrap"><header><div class="logo">{menu.name}</div><div class="tag">{menu.subtitle}</div></header><main><div class="hero"><div class="eyebrow">Nuestro menú / 2026</div><h1>{menu.intro}</h1><p>{menu.description}</p></div><div class="ornament" aria-hidden="true"></div><nav aria-label="Categorías">{menu.categories.map((category,i)=><a href={`#categoria-${i}`}>{category.name}</a>)}</nav>{menu.categories.map((category,i)=><section id={`categoria-${i}`}><h2>{category.name}</h2>{category.items.map(([name,description,price])=><article class="item"><div><h3>{name}</h3><p>{description}</p></div><span class="price">{money(price)}</span></article>)}</section>)}</main><footer><strong>{menu.name}</strong><div>{menu.address}</div><p class="notice">Demostración conceptual de Atmósfera Studio. Negocio y precios ficticios.</p><a href="/">← Ver otras demostraciones</a></footer></div></body></html>